{
	"name": "microgulp",
	"uuid": "de.amekudzi.microgulp",
	"version": "1.0.0",
	"author": "Meinolf Amekudzi",
	"entry": "backend/plugin.cjs",
	"description": "Run µGulp tasks from an ENIAC Flexbar. Requires µGulp with hardware control enabled and an active local hardware-control session. Not available in µGulp Free.",
	"repo": "https://github.com/mamekudz/microGulpFlexBar",
	"sdk": {
		"version": "1.0.9"
	},
	"software": {
		"minimumVersion": "1.3.0"
	},
	"os": [
		{
			"platform": "mac",
			"minimumVersion": "10.15"
		},
		{
			"platform": "windows",
			"minimumVersion": "10"
		}
	],
	"device": [
		{
			"name": "flexbar",
			"version": "1.0.0"
		}
	],
	"configPage": "",
	"keyLibrary": {
		"title": "$PluginName",
		"style": {
			"icon": "mdi mdi-microscope"
		},
		"children": [
			{
				"title": "$Task.Title",
				"tip": "$Task.Tip",
				"cid": "de.amekudzi.microgulp.task",
				"config": {
					"keyType": "default",
					"clickable": true,
					"platform": [
						"windows",
						"mac"
					]
				},
				"style": {
					"icon": "mdi mdi-cog-play",
					"width": 180
				},
				"data": {
					"workspacePath": "",
					"taskId": "",
					"mode": "run"
				}
			},
			{
				"title": "$Browser.Title",
				"tip": "$Browser.Tip",
				"cid": "de.amekudzi.microgulp.browser",
				"config": {
					"keyType": "dynamic",
					"platform": [
						"windows",
						"mac"
					]
				},
				"style": {
					"icon": "mdi mdi-view-column",
					"width": 480
				},
				"data": {
					"workspacePath": "",
					"followActive": false,
					"width": 480,
					"subkeyNum": 0
				}
			}
		]
	},
	"local": {
		"en": {
			"PluginName": "µGulp",
			"Task": {
				"Title": "µGulp Task",
				"Tip": "Start or stop a µGulp task. Persistent tasks toggle; µWatch stays a file trigger.",
				"UI": {
					"Workspace": "Workspace folder",
					"Task": "Task",
					"NoTasks": "Open the µGulp dashboard in that workspace, then refresh.",
					"Mode": "Key action",
					"ModeRun": "Start / stop the task",
					"ModeWatch": "Toggle µWatch",
					"Refresh": "Refresh"
				}
			},
			"Browser": {
				"Title": "µGulp Browser",
				"Tip": "Browse groups and tasks on the Flexbar. Opening a group never starts a task.",
				"UI": {
					"Workspace": "Workspace folder",
					"Follow": "Follow active IDE project",
					"FollowHint": "Uses µGulp active-project context. Ambiguous focus does not pick a workspace.",
					"Width": "Container width (px)",
					"Hint": "Drag once onto the bar. Child keys (max 16) show navigation and tasks with embedded icons."
				}
			}
		}
	}
}
